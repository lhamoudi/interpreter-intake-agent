# ---- Anthropic ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- Twilio (Agent Connect / ConversationRelay) ----
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_API_KEY=SK...
TWILIO_API_SECRET=...
TWILIO_PHONE_NUMBER=+1...

# Public origin this server is reachable at (your Cloudflare-fronted domain).
# ConversationRelay upgrades to wss://<this host><voiceWebsocketPath>.
TWILIO_VOICE_PUBLIC_DOMAIN=intake.example.com

# ---- Persistence (Turso / libSQL) ----
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=...

# ---- Video deflection (Twilio Video + SendGrid email) ----
# The join link for the video-session tier is emailed (SMS is A2P 10DLC-gated).
# SendGrid is Twilio-owned; needs an API key + a verified single-sender address.
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=you@yourdomain.com
# Base URL of the video join page (no join-page UI is built; placeholder is fine).
VIDEO_JOIN_BASE_URL=https://video.example.com/join

# ---- Human handoff (voice-only mode → Studio → Flex) ----
# On the human tier, TAC sets session.pendingHandoffData; when this Flow SID is
# set TAC wires the ConversationRelay <Connect action> URL to the Studio Flow,
# which routes the call into Flex via TaskRouter. Must match FW[0-9a-f]{32} or
# TACConfig.fromEnv() refuses to start — leave commented until you have a real SID.
# TWILIO_STUDIO_HANDOFF_FLOW_SID=FW...

# Salt for hashing caller numbers before they are stored as memory keys.
CALLER_HASH_SALT=change-me
